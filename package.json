{
  "name": "react-projects",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:calculator-v1": "npm run dev -w calculator-version-1",
    "build:calculator-v1": "npm run build -w calculator-version-1",
    "dev:todo-v1": "npm run dev -w todo-app-version-1",
    "build:todo-v1": "npm run build -w todo-app-version-1",
    "dev:todo-v2": "npm run dev -w todo-app-version-2",
    "build:todo-v2": "npm run build -w todo-app-version-2",
    "dev:bharat-clock": "npm run dev -w bharat-clock",
    "build:bharat-clock": "npm run build -w bharat-clock",
    "dev:healthy-food-list": "npm run dev -w healthy-food-list",
    "build:healthy-food-list": "npm run build -w healthy-food-list",
    "dev:calculator-v2": "npm run dev -w calculator-version-2",
    "build:calculator-v2": "npm run build -w calculator-version-2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "vite": "^5.4.21"
  }
}
